<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Only for "Save to gallery" on Android 9 and older; newer versions need no permission. -->
    <uses-permission
        android:name="android.permission.WRITE_EXTERNAL_STORAGE"
        android:maxSdkVersion="28" />

    <!-- Reminder and Timer notifications. Android 13+ asks the user; FamilyApp only asks when
         alerts are turned on in Settings. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Exact "time's up" for the Timer. The user grants it in Android settings (Android 12+);
         without it the Timer alert is approximate. -->
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" />
    <!-- Set the Timer alarm again after the phone restarts. -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <!-- The app works without a camera; only "Capture Moments" uses one. -->
    <uses-feature
        android:name="android.hardware.camera"
        android:required="false" />

    <!-- Lets the app find a camera app and a calendar app on Android 11+. -->
    <queries>
        <intent>
            <action android:name="android.media.action.IMAGE_CAPTURE" />
        </intent>
        <intent>
            <action android:name="android.intent.action.INSERT" />
            <data android:mimeType="vnd.android.cursor.dir/event" />
        </intent>
    </queries>

    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.FamilyApp">
        <activity
            android:name=".viewCalendar"
            android:exported="false"
            android:label="@string/title_schedule" />
        <activity
            android:name=".ActivitiesFun"
            android:exported="false"
            android:label="@string/title_activities" />
        <activity
            android:name=".ContactUs"
            android:exported="false"
            android:label="@string/title_contact" />
        <activity
            android:name=".CheckList"
            android:exported="false"
            android:label="@string/title_checklist" />
        <activity
            android:name=".PhotoGallery"
            android:exported="false"
            android:label="@string/title_photos" />
        <activity
            android:name=".AddEvents"
            android:exported="false"
            android:label="@string/title_events" />
        <activity
            android:name=".ToDoList"
            android:exported="false"
            android:label="@string/title_todo" />
        <activity
            android:name=".Reading"
            android:exported="false"
            android:label="@string/title_reading" />
        <activity
            android:name=".FamAppTimer"
            android:exported="false"
            android:label="@string/title_timer" />
        <activity
            android:name=".MealPlanner"
            android:exported="false"
            android:label="@string/title_meals" />
        <activity
            android:name=".FamilyMembersActivity"
            android:exported="false"
            android:label="@string/feat_members" />
        <activity
            android:name=".SettingsActivity"
            android:exported="false"
            android:label="@string/title_settings" />
        <activity
            android:name=".DatabaseProblemActivity"
            android:exported="false" />
        <activity
            android:name=".HubActivity"
            android:exported="false" />
        <activity
            android:name=".AboutActivity"
            android:exported="false"
            android:label="@string/title_about" />
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:theme="@style/Theme.FamilyApp.Starting">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Notification buttons ("Done", "Tomorrow") and the Timer alarm: not exported, so only
             FamilyApp's own immutable PendingIntents can reach them. -->
        <receiver
            android:name=".reminders.ReminderActionReceiver"
            android:exported="false" />
        <receiver
            android:name=".reminders.TimerAlarm$Receiver"
            android:exported="false" />
        <!-- Not exported: Android's own "phone finished starting" broadcast still reaches it. -->
        <receiver
            android:name=".reminders.BootReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
            </intent-filter>
        </receiver>

        <!-- Shares photo files with the camera app so it can save full-size pictures. -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>
    </application>

</manifest>
