<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- One theme for the whole app: Material 3 colours, the Poppins font and shared widget styles.
         Dark mode uses the same theme with the colours from values-night/colors.xml. -->
    <style name="Theme.FamilyApp" parent="Theme.Material3.DayNight">
        <item name="colorPrimary">@color/fa_primary</item>
        <item name="colorOnPrimary">@color/fa_on_primary</item>
        <item name="colorPrimaryContainer">@color/fa_primary_container</item>
        <item name="colorOnPrimaryContainer">@color/fa_on_primary_container</item>
        <item name="colorSecondary">@color/fa_secondary</item>
        <item name="colorOnSecondary">@color/fa_on_secondary</item>
        <item name="colorSecondaryContainer">@color/fa_secondary_container</item>
        <item name="colorOnSecondaryContainer">@color/fa_on_secondary_container</item>
        <item name="colorTertiary">@color/fa_tertiary</item>
        <item name="colorOnTertiary">@color/fa_on_tertiary</item>
        <item name="colorTertiaryContainer">@color/fa_tertiary_container</item>
        <item name="colorOnTertiaryContainer">@color/fa_on_tertiary_container</item>
        <item name="colorError">@color/fa_error</item>
        <item name="colorOnError">@color/fa_on_error</item>
        <item name="colorErrorContainer">@color/fa_error_container</item>
        <item name="colorOnErrorContainer">@color/fa_on_error_container</item>
        <item name="android:colorBackground">@color/fa_background</item>
        <item name="colorOnBackground">@color/fa_on_background</item>
        <item name="colorSurface">@color/fa_surface</item>
        <item name="colorOnSurface">@color/fa_on_surface</item>
        <item name="colorSurfaceVariant">@color/fa_surface_variant</item>
        <item name="colorOnSurfaceVariant">@color/fa_on_surface_variant</item>
        <item name="colorSurfaceContainer">@color/fa_surface_container</item>
        <item name="colorSurfaceContainerLow">@color/fa_surface_container</item>
        <item name="colorOutline">@color/fa_outline</item>
        <item name="colorOutlineVariant">@color/fa_outline_variant</item>

        <item name="colorAccent4Container">@color/fa_accent4_container</item>
        <item name="colorOnAccent4Container">@color/fa_accent4</item>

        <!-- Status bar matches the title bar. -->
        <item name="android:statusBarColor">@color/fa_bar</item>
        <item name="android:windowLightStatusBar" tools:targetApi="m">false</item>

        <!-- Poppins everywhere -->
        <item name="fontFamily">@font/poppins</item>
        <item name="android:fontFamily">@font/poppins</item>
        <item name="textAppearanceHeadlineMedium">@style/TextAppearance.FamilyApp.HeadlineMedium</item>
        <item name="textAppearanceHeadlineSmall">@style/TextAppearance.FamilyApp.HeadlineSmall</item>
        <item name="textAppearanceTitleLarge">@style/TextAppearance.FamilyApp.TitleLarge</item>
        <item name="textAppearanceTitleMedium">@style/TextAppearance.FamilyApp.TitleMedium</item>
        <item name="textAppearanceTitleSmall">@style/TextAppearance.FamilyApp.TitleSmall</item>
        <item name="textAppearanceBodyLarge">@style/TextAppearance.FamilyApp.BodyLarge</item>
        <item name="textAppearanceBodyMedium">@style/TextAppearance.FamilyApp.BodyMedium</item>
        <item name="textAppearanceBodySmall">@style/TextAppearance.FamilyApp.BodySmall</item>
        <item name="textAppearanceLabelLarge">@style/TextAppearance.FamilyApp.LabelLarge</item>
        <item name="textAppearanceLabelMedium">@style/TextAppearance.FamilyApp.LabelMedium</item>
        <item name="android:textAppearance">@style/TextAppearance.FamilyApp.BodyLarge</item>

        <!-- Title bar -->
        <item name="actionBarStyle">@style/Widget.FamilyApp.ActionBar</item>
        <item name="actionBarTheme">@style/ThemeOverlay.FamilyApp.ActionBar</item>

        <!-- Widgets -->
        <item name="materialButtonStyle">@style/Widget.FamilyApp.Button</item>
        <item name="materialCardViewStyle">@style/Widget.FamilyApp.Card</item>
        <item name="textInputStyle">@style/Widget.FamilyApp.TextInput</item>
        <item name="materialAlertDialogTheme">@style/ThemeOverlay.FamilyApp.Dialog</item>

        <!-- Keep content below the status bar on Android 15+. -->
        <item name="android:windowOptOutEdgeToEdgeEnforcement" tools:targetApi="35">true</item>
    </style>

    <!-- Home screen: no title bar, the header picture is the title. -->
    <style name="Theme.FamilyApp.NoActionBar">
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
        <item name="android:statusBarColor">@color/fa_background</item>
        <item name="android:windowLightStatusBar" tools:targetApi="m">@bool/light_status_bar</item>
    </style>
</resources>
