    <string name="area_documents_note">Only the date is saved. Please don\'t enter passport, card, licence or account numbers. Renewal rules differ between countries, so check the dates that apply to you.</string>
    <string name="area_library_note">Just the book title and its return date. No library card number is needed.</string>
    <string name="area_health_note">A simple date reminder, not a medical record. Use the dates your healthcare provider gives you; FamilyApp doesn\'t suggest medical schedules.</string>
    <string name="area_home_note">Suggested schedules only. For alarms, heating and other safety equipment, follow the manufacturer\'s instructions and local guidance.</string>
    <string name="area_school_note">No school names or full names needed. A nickname is enough.</string>
    <string name="area_bills_note">FamilyApp only reminds you. It never asks for bank or card details and never makes payments.</string>
    <string name="area_vehicle_note">Use your own service intervals. No plate or vehicle numbers are needed.</string>
    <string name="area_family_note">Friendly ideas for time together, whenever it suits you.</string>
    <string name="area_pets_note">Simple care reminders. No veterinary records are needed.</string>
    <string name="area_garden_note">Change the schedule to suit your plants and your weather.</string>
    <string name="area_hobbies_note">A gentle nudge for things you enjoy. Skip any week you like.</string>
    <string name="area_digital_note">FamilyApp never asks for passwords, codes or security answers, and never changes anything on your devices.</string>
    <string name="area_food_note">Daily habits like drinking water are in Healthy Habits, and lunch ideas are in Meal Planner.</string>

