<?xml version="1.0" encoding="utf-8"?>
<!-- Shared text and widget styles. Every screen uses these, so sizes and colours stay consistent. -->
<resources>
    <!-- Text -->
    <style name="TextAppearance.FamilyApp.HeadlineMedium" parent="TextAppearance.Material3.HeadlineMedium">
        <item name="fontFamily">@font/poppins_semibold</item>
        <item name="android:fontFamily">@font/poppins_semibold</item>
        <item name="android:textSize">28sp</item>
    </style>
    <style name="TextAppearance.FamilyApp.HeadlineSmall" parent="TextAppearance.Material3.HeadlineSmall">
        <item name="fontFamily">@font/poppins_semibold</item>
        <item name="android:fontFamily">@font/poppins_semibold</item>
        <item name="android:textSize">22sp</item>
    </style>
    <style name="TextAppearance.FamilyApp.TitleLarge" parent="TextAppearance.Material3.TitleLarge">
        <item name="fontFamily">@font/poppins_semibold</item>
        <item name="android:fontFamily">@font/poppins_semibold</item>
        <item name="android:textSize">20sp</item>
    </style>
    <style name="TextAppearance.FamilyApp.TitleMedium" parent="TextAppearance.Material3.TitleMedium">
        <item name="fontFamily">@font/poppins_medium</item>
        <item name="android:fontFamily">@font/poppins_medium</item>
        <item name="android:textSize">16sp</item>
    </style>
    <style name="TextAppearance.FamilyApp.TitleSmall" parent="TextAppearance.Material3.TitleSmall">
        <item name="fontFamily">@font/poppins_medium</item>
        <item name="android:fontFamily">@font/poppins_medium</item>
        <item name="android:textSize">14sp</item>
    </style>
    <style name="TextAppearance.FamilyApp.BodyLarge" parent="TextAppearance.Material3.BodyLarge">
        <item name="fontFamily">@font/poppins_regular</item>
        <item name="android:fontFamily">@font/poppins_regular</item>
        <item name="android:textSize">16sp</item>
    </style>
    <style name="TextAppearance.FamilyApp.BodyMedium" parent="TextAppearance.Material3.BodyMedium">
        <item name="fontFamily">@font/poppins_regular</item>
        <item name="android:fontFamily">@font/poppins_regular</item>
        <item name="android:textSize">14sp</item>
    </style>
    <style name="TextAppearance.FamilyApp.BodySmall" parent="TextAppearance.Material3.BodySmall">
        <item name="fontFamily">@font/poppins_regular</item>
        <item name="android:fontFamily">@font/poppins_regular</item>
        <item name="android:textSize">12sp</item>
    </style>
    <style name="TextAppearance.FamilyApp.LabelLarge" parent="TextAppearance.Material3.LabelLarge">
        <item name="fontFamily">@font/poppins_medium</item>
        <item name="android:fontFamily">@font/poppins_medium</item>
        <item name="android:textSize">14sp</item>
    </style>
    <style name="TextAppearance.FamilyApp.LabelMedium" parent="TextAppearance.Material3.LabelMedium">
        <item name="fontFamily">@font/poppins_medium</item>
        <item name="android:fontFamily">@font/poppins_medium</item>
        <item name="android:textSize">12sp</item>
    </style>
    <!-- Large countdown digits on the Timer -->
    <style name="TextAppearance.FamilyApp.Display" parent="TextAppearance.Material3.DisplayMedium">
        <item name="fontFamily">@font/poppins_semibold</item>
        <item name="android:fontFamily">@font/poppins_semibold</item>
        <item name="android:textSize">52sp</item>
        <item name="android:fontFeatureSettings">tnum</item>
    </style>

    <!-- Title bar -->
    <style name="Widget.FamilyApp.ActionBar" parent="Widget.Material3.ActionBar.Solid">
        <item name="background">@color/fa_bar</item>
        <item name="titleTextStyle">@style/TextAppearance.FamilyApp.ActionBarTitle</item>
        <item name="elevation">0dp</item>
    </style>
    <style name="TextAppearance.FamilyApp.ActionBarTitle" parent="TextAppearance.FamilyApp.TitleLarge">
        <item name="android:textColor">@color/fa_on_bar</item>
    </style>
    <style name="ThemeOverlay.FamilyApp.ActionBar" parent="ThemeOverlay.Material3.Dark.ActionBar">
        <item name="colorControlNormal">@color/fa_on_bar</item>
        <item name="android:textColorPrimary">@color/fa_on_bar</item>
    </style>

    <!-- Buttons: rounded, at least 48dp tall -->
    <style name="Widget.FamilyApp.Button" parent="Widget.Material3.Button">
        <item name="iconGravity">textStart</item>
        <item name="cornerRadius">12dp</item>
        <item name="android:minHeight">@dimen/touch_target</item>
        <item name="android:textAppearance">@style/TextAppearance.FamilyApp.LabelLarge</item>
    </style>
    <style name="Widget.FamilyApp.Button.Tonal" parent="Widget.Material3.Button.TonalButton">
        <item name="iconGravity">textStart</item>
        <item name="cornerRadius">12dp</item>
        <item name="android:minHeight">@dimen/touch_target</item>
        <item name="android:textAppearance">@style/TextAppearance.FamilyApp.LabelLarge</item>
    </style>
    <style name="Widget.FamilyApp.Button.Outlined" parent="Widget.Material3.Button.OutlinedButton">
        <item name="iconGravity">textStart</item>
        <item name="cornerRadius">12dp</item>
        <item name="android:minHeight">@dimen/touch_target</item>
        <item name="android:textAppearance">@style/TextAppearance.FamilyApp.LabelLarge</item>
    </style>
    <style name="Widget.FamilyApp.Button.Text" parent="Widget.Material3.Button.TextButton">
        <item name="iconGravity">textStart</item>
        <item name="android:minHeight">@dimen/touch_target</item>
        <item name="android:textAppearance">@style/TextAppearance.FamilyApp.LabelLarge</item>
    </style>
    <!-- Small round icon button used in list rows (edit / delete) -->
    <style name="Widget.FamilyApp.IconButton" parent="Widget.Material3.Button.IconButton">
        <item name="android:minWidth">@dimen/touch_target</item>
        <item name="android:minHeight">@dimen/touch_target</item>
        <item name="iconTint">?attr/colorOnSurfaceVariant</item>
    </style>

    <!-- Cards -->
    <style name="Widget.FamilyApp.Card" parent="Widget.Material3.CardView.Outlined">
        <item name="cardCornerRadius">@dimen/card_radius</item>
        <item name="cardBackgroundColor">@color/fa_surface_container</item>
        <item name="strokeColor">@color/fa_outline_variant</item>
    </style>

    <!-- Text fields -->
    <style name="Widget.FamilyApp.TextInput" parent="Widget.Material3.TextInputLayout.OutlinedBox">
        <item name="boxCornerRadiusTopStart">12dp</item>
        <item name="boxCornerRadiusTopEnd">12dp</item>
        <item name="boxCornerRadiusBottomStart">12dp</item>
        <item name="boxCornerRadiusBottomEnd">12dp</item>
    </style>

    <!-- Dialogs -->
    <style name="ThemeOverlay.FamilyApp.Dialog" parent="ThemeOverlay.Material3.MaterialAlertDialog">
        <item name="fontFamily">@font/poppins</item>
        <item name="android:fontFamily">@font/poppins</item>
    </style>

    <!-- Section headings inside screens -->
    <style name="FamilyApp.SectionTitle" parent="">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textAppearance">?attr/textAppearanceTitleMedium</item>
        <item name="android:textColor">?attr/colorOnSurface</item>
        <item name="android:layout_marginTop">@dimen/space_l</item>
        <item name="android:layout_marginBottom">@dimen/space_s</item>
    </style>
    <!-- Helper text under headings -->
    <style name="FamilyApp.Hint" parent="">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textAppearance">?attr/textAppearanceBodyMedium</item>
        <item name="android:textColor">?attr/colorOnSurfaceVariant</item>
    </style>
    <!-- Scrollable screen content with the standard padding -->
    <style name="FamilyApp.ScreenContent" parent="">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:orientation">vertical</item>
        <item name="android:paddingStart">@dimen/screen_padding</item>
        <item name="android:paddingEnd">@dimen/screen_padding</item>
        <item name="android:paddingTop">@dimen/space_l</item>
        <item name="android:paddingBottom">@dimen/space_xl</item>
    </style>
</resources>
