<!-- Smart Checklists (Phase 4): screens and reusable templates. -->
<resources>
    <!-- Checklists screen -->
    <string name="lists_intro">Tick things off as you go. Your lists, items and ticks stay on this phone until you change them.</string>
    <string name="lists_new">New checklist</string>
    <string name="lists_empty">No checklists yet. Tap New checklist to start one from a template or a blank page.</string>
    <string name="lists_archived">Archived</string>
