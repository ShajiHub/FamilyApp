    <string name="lists_blank">Blank checklist</string>
    <string name="lists_name_hint">Checklist name</string>
    <string name="lists_name_too_long">Please keep the name under 60 characters</string>
    <string name="lists_create">Create</string>
    <string name="lists_new_title">New checklist</string>
    <plurals name="lists_items_count">
        <item quantity="one">%1$d item</item>
        <item quantity="other">%1$d items</item>
    </plurals>
    <string name="lists_templates_intro">Ready-made lists to copy and change as you like. The templates themselves never change, and nothing is added until you choose one.</string>
    <string name="lists_for_hint">For (optional)</string>
    <string name="lists_nickname_hint">A nickname is enough, for example \"Kid 1\".</string>

