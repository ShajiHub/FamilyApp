    <string name="list_item_more">More options for %1$s</string>
    <string name="list_item_edit">Edit item</string>
    <string name="list_item_delete">Delete item</string>
    <string name="list_item_note_hint">Note (optional), for example \"2 pairs\"</string>
    <string name="list_item_hint">Item</string>
    <string name="list_rename">Rename</string>
    <string name="list_duplicate">Duplicate</string>
    <string name="list_duplicate_title">Duplicate checklist</string>
    <string name="list_copy_name">%1$s (copy)</string>
    <string name="list_reset">Start again (untick all)</string>
    <string name="list_reset_title">Untick everything in %1$s?</string>
    <string name="list_reset_message">All items stay in the list; only the ticks are cleared. Handy for the next season or trip.</string>
    <string name="list_reset_confirm">Untick all</string>
    <string name="list_archive">Archive</string>
    <string name="list_restore">Restore</string>
    <string name="list_archived_note">This checklist is archived. Restore it to show it with your other lists.</string>
    <string name="list_delete">Delete checklist</string>
