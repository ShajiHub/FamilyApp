    <string name="list_delete_message">%1$s and everything in it will be deleted. This can\'t be undone. To keep it out of the way instead, use Archive.</string>
    <string name="list_all_done">All done. Well done!</string>
    <string name="list_hold_hint">Tap an item to tick it. Use ⋮ to edit or delete it.</string>

