    <!-- About -->
    <string name="title_about">About FamilyApp</string>
    <string name="about_logo_description">Shajis Creative Labs logo</string>
    <string name="about_version">Version %1$s</string>
    <string name="about_purpose_title">What FamilyApp is for</string>
    <string name="about_purpose">FamilyApp helps families organise everyday life, build healthy habits, share responsibilities, keep track of important dates, explore hobbies and learn together. It is designed for parents and children to use side by side.</string>
    <string name="about_privacy_title">Your privacy</string>
    <string name="about_privacy">• Everything you enter stays on this phone. FamilyApp has no account, no ads and no tracking.\n• It works offline. Sharing, email and opening links use other apps on your phone, only when you choose to.\n• Photos you save to the gallery stay in your phone\'s gallery.\n• Android may include FamilyApp\'s data in your phone\'s backup if backup is turned on in your phone\'s settings.\n• Uninstalling FamilyApp or clearing its storage deletes the data saved in the app.</string>
    <string name="about_developer_title">Developer</string>
    <string name="about_credits_title">Credits</string>
    <string name="about_credits">FamilyApp is developed by Shajis Creative Labs.\nFont: Poppins, SIL Open Font License 1.1.\nIcons: Material Icons, Apache License 2.0.\nBuilt with open-source AndroidX, Material Components and Room libraries (Apache License 2.0).</string>

