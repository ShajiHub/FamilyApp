<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="@dimen/space_xl"
        android:paddingTop="@dimen/space_s"
        android:paddingEnd="@dimen/space_xl">

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/memberNameLayout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/members_name_hint"
            app:counterEnabled="true"
            app:counterMaxLength="40"
            app:helperText="@string/members_name_helper">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/memberNameInput"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="textPersonName|textCapWords"
                android:maxLength="40" />
        </com.google.android.material.textfield.TextInputLayout>

        <TextView
            style="@style/FamilyApp.SectionTitle"
            android:layout_marginTop="@dimen/space_m"
            android:text="@string/members_avatar" />

        <com.google.android.material.chip.ChipGroup
            android:id="@+id/memberAvatars"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:selectionRequired="true"
            app:singleSelection="true" />

        <TextView
            style="@style/FamilyApp.SectionTitle"
            android:layout_marginTop="@dimen/space_m"
            android:text="@string/members_colour" />

        <com.google.android.material.chip.ChipGroup
            android:id="@+id/memberColours"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:selectionRequired="true"
            app:singleSelection="true" />

        <TextView
            style="@style/FamilyApp.SectionTitle"
            android:layout_marginTop="@dimen/space_m"
            android:text="@string/members_role" />

        <com.google.android.material.chip.ChipGroup
            android:id="@+id/memberRoles"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:selectionRequired="true"
            app:singleSelection="true">

            <com.google.android.material.chip.Chip
                android:id="@+id/roleParent"
                style="@style/Widget.Material3.Chip.Filter"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/role_parent" />

            <com.google.android.material.chip.Chip
                android:id="@+id/roleChild"
                style="@style/Widget.Material3.Chip.Filter"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/role_child" />

            <com.google.android.material.chip.Chip
                android:id="@+id/roleOther"
                style="@style/Widget.Material3.Chip.Filter"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/role_other" />
        </com.google.android.material.chip.ChipGroup>
    </LinearLayout>
</ScrollView>
