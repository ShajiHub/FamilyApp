<?xml version="1.0" encoding="utf-8"?>
<!-- Plans for the selected day: used by both the portrait and landscape schedule screens. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <TextView
        android:id="@+id/scheduleDate"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:fontFamily="@font/boogaloo"
        android:textColor="#1F4F49"
        android:textSize="22sp" />

    <TextView
        android:id="@+id/scheduleMonthCount"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textColor="#3C6E68"
        android:textSize="14sp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <EditText
            android:id="@+id/scheduleInput"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:autofillHints=""
            android:hint="@string/schedule_hint"
            android:imeOptions="actionDone"
            android:inputType="textCapSentences"
            android:minHeight="48dp"
            android:textColor="#102522"
            android:textColorHint="#5B7C78" />

        <Button
            android:id="@+id/scheduleAdd"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:backgroundTint="#4D9E93"
            android:text="@string/schedule_add" />
    </LinearLayout>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <ListView
            android:id="@+id/scheduleList"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

        <TextView
            android:id="@+id/scheduleEmpty"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="16dp"
            android:text="@string/schedule_empty"
            android:textAlignment="center"
            android:textColor="#5B7C78" />
    </FrameLayout>
</LinearLayout>
