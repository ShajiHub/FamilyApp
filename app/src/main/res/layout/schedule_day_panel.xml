<?xml version="1.0" encoding="utf-8"?>
<!-- Events for the selected day: used by both the portrait and landscape schedule screens. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/scheduleDate"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textAppearance="?attr/textAppearanceTitleLarge"
                android:textColor="?attr/colorOnBackground" />

            <TextView
                android:id="@+id/scheduleMonthCount"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textAppearance="?attr/textAppearanceBodySmall"
                android:textColor="?attr/colorOnSurfaceVariant" />
        </LinearLayout>

        <Button
            android:id="@+id/scheduleAdd"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/space_s"
            android:text="@string/schedule_add"
            app:icon="@drawable/ic_add" />
    </LinearLayout>

    <!-- Event cards are added here by the code. -->
    <LinearLayout
        android:id="@+id/scheduleList"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_s"
        android:orientation="vertical" />

    <!-- Family reminders due on this day (Reminders & Renewals), shown under the events. -->
    <TextView
        android:id="@+id/scheduleRemindersTitle"
        style="@style/FamilyApp.SectionTitle"
        android:layout_marginTop="@dimen/space_l"
        android:text="@string/schedule_reminders_title"
        android:visibility="gone" />

    <LinearLayout
        android:id="@+id/scheduleReminders"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical" />

    <TextView
        android:id="@+id/scheduleEmpty"
        style="@style/FamilyApp.Hint"
        android:layout_marginTop="@dimen/space_l"
        android:gravity="center"
        android:text="@string/schedule_empty" />
</LinearLayout>
