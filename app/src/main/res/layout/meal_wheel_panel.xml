<?xml version="1.0" encoding="utf-8"?>
<!-- Wheel, result and Spin button (used in portrait and landscape). -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="center_horizontal"
    android:orientation="vertical">

    <TextView
        android:id="@+id/spintext"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:minHeight="56dp"
        android:text="@string/meal_prompt"
        android:textAppearance="?attr/textAppearanceTitleLarge"
        android:textColor="?attr/colorOnBackground" />

    <com.shajitha.familyapp.FoodWheelView
        android:id="@+id/spinBoard"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_s" />

    <Button
        android:id="@+id/spin"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_l"
        android:text="@string/meal_spin"
        app:icon="@drawable/ic_casino" />
</LinearLayout>
