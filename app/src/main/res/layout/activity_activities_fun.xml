<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#353333"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:padding="24dp">

        <TextView
            android:id="@+id/textView7"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/boogaloo"
            android:text="@string/activities_title"
            android:textColor="#F1DDDD"
            android:textSize="32sp" />

        <ImageView
            android:id="@+id/imageView"
            android:layout_width="200dp"
            android:layout_height="200dp"
            android:layout_marginTop="16dp"
            android:contentDescription="@string/activities_title"
            android:scaleType="fitCenter"
            android:src="@drawable/checking" />

        <!-- The current idea -->
        <TextView
            android:id="@+id/textView8"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:minHeight="96dp"
            android:gravity="center"
            android:text="@string/activities_prompt"
            android:textColor="#EFEBEB"
            android:textSize="22sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:orientation="horizontal">

            <Button
                android:id="@+id/indoorIdea"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginEnd="8dp"
                android:layout_weight="1"
                android:backgroundTint="#829DCA"
                android:fontFamily="@font/boogaloo"
                android:text="@string/activities_indoor"
                android:textColor="#0E0E0E"
                android:textSize="18sp" />

            <Button
                android:id="@+id/outdoorIdea"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:backgroundTint="#85AE56"
                android:fontFamily="@font/boogaloo"
                android:text="@string/activities_outdoor"
                android:textColor="#0E0E0E"
                android:textSize="18sp" />
        </LinearLayout>

        <Button
            android:id="@+id/readingLog"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:backgroundTint="#E8D46D"
            android:fontFamily="@font/boogaloo"
            android:text="@string/activities_reading"
            android:textColor="#0E0E0E"
            android:textSize="18sp" />
    </LinearLayout>
</ScrollView>
