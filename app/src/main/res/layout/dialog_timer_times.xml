<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingStart="@dimen/space_xl"
    android:paddingTop="@dimen/space_s"
    android:paddingEnd="@dimen/space_xl">

    <com.google.android.material.textfield.TextInputLayout
        android:id="@+id/minutesGetReadyLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="@string/timer_minutes_get_ready">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/minutesGetReady"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:inputType="number"
            android:maxLength="3" />
    </com.google.android.material.textfield.TextInputLayout>

    <com.google.android.material.textfield.TextInputLayout
        android:id="@+id/minutesScreenTimeLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_s"
        android:hint="@string/timer_minutes_screen_time">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/minutesScreenTime"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:inputType="number"
            android:maxLength="3" />
    </com.google.android.material.textfield.TextInputLayout>

    <com.google.android.material.textfield.TextInputLayout
        android:id="@+id/minutesCleanUpLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_s"
        android:hint="@string/timer_minutes_clean_up">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/minutesCleanUp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:inputType="number"
            android:maxLength="3" />
    </com.google.android.material.textfield.TextInputLayout>
</LinearLayout>
