<?xml version="1.0" encoding="utf-8"?>
<!-- "Add new item" field at the bottom of each checklist. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingStart="@dimen/space_xs"
    android:paddingTop="@dimen/space_xs">

    <com.google.android.material.textfield.TextInputLayout
        android:id="@+id/addItemLayout"
        style="@style/Widget.Material3.TextInputLayout.OutlinedBox.Dense"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:hint="@string/checklist_add_new"
        app:boxCornerRadiusBottomEnd="12dp"
        app:boxCornerRadiusBottomStart="12dp"
        app:boxCornerRadiusTopEnd="12dp"
        app:boxCornerRadiusTopStart="12dp">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/addItemInput"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:imeOptions="actionDone"
            android:inputType="textCapSentences"
            android:maxLength="120" />
    </com.google.android.material.textfield.TextInputLayout>

    <Button
        android:id="@+id/addItemButton"
        style="@style/Widget.FamilyApp.IconButton"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:contentDescription="@string/checklist_add_item"
        app:icon="@drawable/ic_add"
        app:iconTint="?attr/colorPrimary" />
</LinearLayout>
