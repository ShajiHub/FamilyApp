<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?android:attr/colorBackground"
    android:orientation="vertical"
    android:paddingStart="@dimen/space_s"
    android:paddingTop="@dimen/space_s"
    android:paddingEnd="@dimen/space_s"
    android:paddingBottom="@dimen/space_s">

    <com.shajitha.familyapp.whiteboard.DrawingView
        android:id="@+id/drawingView"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <include
        layout="@layout/whiteboard_tools"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_s" />
</LinearLayout>
