<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingStart="@dimen/space_xs"
    android:paddingEnd="@dimen/space_xs">

    <TextView
        style="@style/FamilyApp.Hint"
        android:text="@string/whiteboard_intro" />

    <Button
        android:id="@+id/newDrawing"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_m"
        android:layout_marginBottom="@dimen/space_s"
        android:text="@string/whiteboard_new"
        app:icon="@drawable/ic_add" />

    <TextView
        android:id="@+id/whiteboardEmpty"
        style="@style/FamilyApp.Hint"
        android:layout_marginTop="@dimen/space_l"
        android:gravity="center"
        android:text="@string/whiteboard_empty"
        android:visibility="gone" />
</LinearLayout>
