<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingStart="@dimen/space_xs"
    android:paddingEnd="@dimen/space_xs">

    <com.google.android.material.card.MaterialCardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_s"
        app:cardBackgroundColor="@color/white"
        app:strokeWidth="0dp">

        <ImageView
            android:id="@+id/homeHeader"
            android:layout_width="match_parent"
            android:layout_height="@dimen/home_header_height"
            android:contentDescription="@string/home_header_description"
            android:scaleType="centerCrop"
            android:src="@drawable/famappheaderblack" />
    </com.google.android.material.card.MaterialCardView>

    <TextView
        android:id="@+id/homeGreeting"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_l"
        android:textAppearance="?attr/textAppearanceHeadlineSmall"
        android:textColor="?attr/colorOnBackground" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/space_s"
        android:text="@string/home_subtitle"
        android:textAppearance="?attr/textAppearanceBodyMedium"
        android:textColor="?attr/colorOnSurfaceVariant" />
</LinearLayout>
