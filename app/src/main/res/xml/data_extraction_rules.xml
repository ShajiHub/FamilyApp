<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+ cloud backup and device-to-device transfer. Same rules as backup_rules.xml. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="database" path="family-v1-backup.db" />
        <exclude domain="database" path="family-replaced.db" />
        <exclude domain="database" path="androidx.work.workdb" />
        <exclude domain="database" path="androidx.work.workdb-wal" />
        <exclude domain="database" path="androidx.work.workdb-shm" />
        <exclude domain="sharedpref" path="family_store.xml" />
        <exclude domain="sharedpref" path="db_guard.xml" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="database" path="family-v1-backup.db" />
        <exclude domain="database" path="family-replaced.db" />
        <exclude domain="database" path="androidx.work.workdb" />
        <exclude domain="database" path="androidx.work.workdb-wal" />
        <exclude domain="database" path="androidx.work.workdb-shm" />
        <exclude domain="sharedpref" path="db_guard.xml" />
    </device-transfer>
</data-extraction-rules>
